{
  "build": {
    "arduino":{"ldscript": "esp32p4_out.ld"},
    "core": "esp32",
    "extra_flags": "-DARDUINO_ESP32P4_DEV -DARDUINO_USB_MODE=1 -DARDUINO_USB_CDC_ON_BOOT=1",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "dio",
    "mcu": "esp32p4",
    "variant": "esp32p4"
  },
  "connectivity": ["wifi", "bluetooth"],
  "debug": {
    "openocd_board": "esp32p4.cfg"
  },
  "frameworks": ["arduino"],
  "name": "ESP32-P4 DevKit (custom)",
  "upload": {
    "maximum_ram_size": 524288,
    "maximum_size": 8388608,
    "require_upload_port": true,
    "speed": 460800
  },
  "url": "https://www.espressif.com/",
  "vendor": "Espressif"
}
